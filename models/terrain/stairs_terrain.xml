<mujoco model="stairs terrain scene">

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="120" elevation="-20" />
    <map force="0.01" />
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2" />
    <quality shadowsize="8192" />
  </visual>

  <asset>
    <!-- <hfield name="hfield" file="assets/heightmap_stairs_3x3.png" size="28 28 4 1" /> -->
    <hfield name="hfield" file="assets/heightmap_stairs_5x5.png" size="28 28 4 1" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" pos="0 0 -1.6" type="hfield" hfield="hfield"/>
    <site name="static_site" pos="0 0 2"/>

    <!-- Free body for benchmark: provides frame_body_id and state -->
    <body name="robot_base" pos="0 0 2">
      <freejoint name="root"/>
      <inertial mass="10" pos="0 0 0" diaginertia="0.1 0.1 0.1"/>
      <geom type="box" size="0.2 0.1 0.05" rgba="0.2 0.6 0.8 1"/>
      <site name="base_site" pos="0 0 -0.05" size="0.01"/>
    </body>
  </worldbody>

</mujoco>